# Sprint 16 Environment Variables
# Copy to .env and fill in values

# ─── Rate Limiting ───────────────────────────────────────
# Local development: use in-memory store (default)
# Production: use Upstash REST API
REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Monitoring (Sentry) ────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_ORG=perissos
# SENTRY_PROJECT=backoffice

# ─── Keycloak OIDC (Sprint 16) ──────────────────────────
KEYCLOAK_ENABLED=false
KEYCLOAK_ISSUER=http://localhost:8080/realms/perissos
KEYCLOAK_CLIENT_ID=backoffice
KEYCLOAK_CLIENT_SECRET=perissos-backoffice-secret

# ─── CRM Integration ────────────────────────────────────
# Set to "perissos-crm" when Perissos CRM (Twenty fork) is running
# Set to "twenty" for original Twenty CRM
# Set to "mock" for development (default)
CRM_PROVIDER=mock
# TWENTY_API_URL=http://localhost:3000
# TWENTY_API_KEY=your-api-key

# ─── Perissos CRM (Forked from Twenty CRM) ─────────────
# PERISSOS_CRM_API_URL=http://localhost:3002
# PERISSOS_CRM_API_KEY=your-crm-api-key
# PERISSOS_CRM_ENCRYPTION_KEY=dev-encryption-key-change-in-prod
# PERISSOS_CRM_SERVER_URL=http://localhost:3002
# CRM_PG_USER=perissos_crm
# CRM_PG_PASSWORD=perissos_crm_dev
# CRM_PG_DB=perissos_crm
# CRM_PG_PORT=5433
# CRM_REDIS_PORT=6380

# ─── Apache APISIX (Sprint 16) ──────────────────────────
APISIX_API_KEY=your-admin-key

# ─── Commerce Integration (Sprint 18) ───────────────────
# Set to "medusa" when Perissos Commerce (Medusa fork) is running
# Set to "mock" for development (default)
COMMERCE_PROVIDER=mock
# MEDUSA_API_URL=http://localhost:3100
# MEDUSA_API_KEY=your-medusa-api-key
# MEDUSA_PUBLISHABLE_KEY=your-publishable-key

# ─── Perissos Commerce (Forked from Medusa.js) ─────────
# COMMERCE_PG_USER=perissos_commerce
# COMMERCE_PG_PASSWORD=perissos_commerce_dev
# COMMERCE_PG_DB=perissos_commerce
# COMMERCE_PG_PORT=5434
# COMMERCE_REDIS_PORT=6381
# COMMERCE_SERVER_PORT=3100

# ─── Perissos Accounting (Bigcapital) ───────────────────
# ACCOUNTING_PROVIDER=mock
# BIGCAPITAL_API_URL=http://localhost:3200
# BIGCAPITAL_API_KEY=your-bigcapital-api-key
# BIGCAPITAL_ORG_ID=your-organization-id
# ACCOUNTING_DB_USER=perissos_accounting
# ACCOUNTING_DB_PASSWORD=perissos_accounting_dev
# ACCOUNTING_DB_NAME=perissos_accounting_system
# ACCOUNTING_DB_PORT=3307
# ACCOUNTING_REDIS_PORT=6383
# ACCOUNTING_SERVER_PORT=3200
# ACCOUNTING_JWT_SECRET=dev-jwt-secret-change-in-prod

# ─── Lighthouse CI (Sprint 16) ──────────────────────────
LIGHTHOUSE_THRESHOLD=90

# ─── OWASP ZAP (audit) ─────────────────────────────────
# ZAP_API_KEY=your-zap-api-key
