# ─── Perissos CMS — Root Environment Variables ──────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Payload (Back Office) ──────────────────────────────────────
PAYLOAD_SECRET=your_payload_secret_here_minimum_32_chars
DATABASE_URL=postgresql://user:password@host:5432/perissos_db

# ─── Cloudflare R2 (Media Storage) ───────────────────────────────
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=perissos-media
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_PUBLIC_URL=https://media.perissos.dev
R2_PREFIX=

# ─── Frontend (Cloudflare Pages) ─────────────────────────────────
NEXT_PUBLIC_CMS_URL=http://localhost:3000
NEXT_PUBLIC_R2_URL=https://media.perissos.dev

# ─── Vercel Cron ─────────────────────────────────────────────────
CRON_SECRET=your_cron_secret_here

# ─── Provisioning Script (Sprint 2) ──────────────────────────────
NEON_API_KEY=
NEON_PROJECT_ID=
VERCEL_TOKEN=
VERCEL_ORG_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
RESEND_API_KEY=
